# GripWise Backend — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# ── Application ──────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────
# Use Docker Compose default: gripwise:gripwise@localhost:5432/gripwise
DATABASE_URL=postgresql+asyncpg://gripwise:gripwise@localhost:5432/gripwise
DATABASE_URL_SYNC=postgresql://gripwise:gripwise@localhost:5432/gripwise

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── File Storage ──────────────────────────────────────
IMAGE_DIR=uploads
MAX_IMAGE_SIZE_MB=10

# ── AI Inference ──────────────────────────────────────
# "mock"  → deterministic demo provider (default, no model weights needed)
# "cv_pipeline" → real OpenCV pipeline (Phase 2)
INFERENCE_PROVIDER=mock
